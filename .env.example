# Supabase Credentials (found in your Supabase project dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role key for backend ingestion scripts, or anon key if policies allow
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Embedding Model (BAAI/bge-small-en-v1.5 produces 384-dimension embeddings, super fast & accurate)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
